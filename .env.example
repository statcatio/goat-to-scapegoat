# Copy this file to `.env` and fill in your Reddit "script" app credentials.
# Create an app at: https://www.reddit.com/prefs/apps  ->  "create another app..." -> type: script
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
# Any descriptive string. Reddit asks you to identify your script.
REDDIT_USER_AGENT=wc-hatewatch:v0.1 (by u/your_username)

# --- YouTube Data API v3 -----------------------------------------------------
# Console -> create project -> enable "YouTube Data API v3" -> Credentials ->
# API key. Reading public comments needs only a key (no OAuth, no billing).
YOUTUBE_API_KEY=your_api_key_here
